# Python / tooling
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
venv/
.venv/
.env

# Large binaries: activation tensors and model weights are never committed.
# Commit the extraction script + results/tables/activation_checksums.json instead.
*.npy
*.pt
*.bin
*.safetensors

# Datasets: raw downloads and processed copies (which contain the full dataset
# text) are regenerated by `make data preprocess`, never redistributed here.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Run logs and smoke-test outputs are local only.
results/logs/*
!results/logs/.gitkeep
results/smoke/

# LaTeX intermediates
*.aux
*.log
*.out
*.synctex.gz

# Files over 50 MB must never be committed; `git ls-files -s | ...` check in README.
docs/study_guide/
docs/explained/
